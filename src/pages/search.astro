---
import Layout from '../layouts/Layout.astro';
---

<Layout title="뉴스 검색" noindex>
  <div class="container page-content search-page">
    <div class="page-intro">
      <span class="eyebrow">FIND YOUR CONTEXT</span>
      <h1>
        궁금한 AI를 찾아보세요<span class="dot">.</span>
      </h1>
      <p>기사 제목·요약·출처를 함께 검색합니다.</p>
    </div>
    <form id="search-form" role="search">
      <label class="sr-only" for="global-search">
        검색어
      </label>
      <input
        id="global-search"
        name="q"
        type="search"
        placeholder="예: 클로드, OpenAI, 에이전트"
        autocomplete="off"
      />
      <button class="button" type="submit">
        검색 ↗
      </button>
    </form>
    <p id="search-status" aria-live="polite">
      검색어를 입력하세요.
    </p>
    <ol id="search-results" class="search-results" tabindex="-1"></ol>
    <nav
      class="pagination"
      data-pagination
      aria-label="검색 결과 페이지"
      hidden
    ></nav>
    <button id="search-retry" type="button" hidden>
      다시 시도
    </button>
    <noscript>
      <p>
        검색에는 JavaScript가 필요합니다.{' '}
        <a href="/archive/">아카이브에서 기사를 살펴보세요.</a>
      </p>
    </noscript>
  </div>
</Layout>
<script>
  import '../scripts/search';
</script>
