---
import Layout from '../layouts/Layout.astro';
import Feed from '../components/Feed.astro';
import { articles, data, dateLabel } from '../lib/data';
---

<Layout title="아카이브">
  <div class="container page-content">
    <div class="page-intro">
      <span class="eyebrow">EVERY SIGNAL, IN ONE PLACE</span>
      <h1>
        뉴스 아카이브<span class="dot">.</span>
      </h1>
      <p>
        수집한 개별 기사를 찾아보고, 다시 읽을 뉴스를 저장하세요.
        <br />
        저장한 뉴스는 이 브라우저에만 보관됩니다.
      </p>
      <a class="text-link" href="/briefings/">
        날짜별 종합 브리핑은 히스토리에서 읽어보세요 ↗
      </a>
    </div>
    <Feed articles={articles} archive />
    <p class="brief-history-note">
      기사 데이터 갱신 ·{' '}
      {data.updated_at
        ? `${dateLabel(data.updated_at, true)} KST`
        : '수집 대기'}
    </p>
  </div>
</Layout>
