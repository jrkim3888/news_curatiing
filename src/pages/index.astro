---
import Layout from '../layouts/Layout.astro';
import Feed from '../components/Feed.astro';
import { articles, data, sourceMap, dateLabel } from '../lib/data';
const ranked = [...articles].sort((a, b) => {
  const score = (article: typeof a) =>
    Date.parse(article.published_at) +
    3600000 *
      (sourceMap.get(article.sources[0].source_id)?.role === 'signal'
        ? -12
        : sourceMap
              .get(article.sources[0].source_id)
              ?.role.startsWith('official')
          ? 6
          : 0) +
    (article.status === 'summarized' ? 7200000 : 0);
  return score(b) - score(a);
});
const korea = ranked.find(
  (a) =>
    a.region === 'kr' &&
    sourceMap.get(a.sources[0].source_id)?.role !== 'signal',
);
const global = ranked.find(
  (a) =>
    a.region === 'global' &&
    sourceMap.get(a.sources[0].source_id)?.role.startsWith('official'),
);
const highlights = [korea, global].filter((a): a is NonNullable<typeof a> =>
  Boolean(a),
);
---

<Layout>
  <div class="container">
    <section class="hero">
      <div class="hero-copy">
        <div class="edition">
          <span class="live-dot"></span> YOUR DAILY AI PERSPECTIVE
        </div>
        <h1>
          AI의 다음을,
          <br />
          <em>한눈에.</em>
        </h1>
        <p>
          쏟아지는 소식 사이, 놓치지 말아야 할 변화.
          <br />
          국내외 AI 뉴스와 그 맥락을 한곳에서 읽어보세요.
        </p>
        <a class="text-link" href="#briefing">
          최신 브리핑 읽기 <span>↓</span>
        </a>
      </div>
      <div class="hero-graphic" aria-hidden="true">
        <div class="orbit orbit-one"></div>
        <div class="orbit orbit-two"></div>
        <div class="orbit orbit-three"></div>
        <div class="graphic-cross">
          <svg viewBox="0 0 180 180" width="100%" height="100%">
            <g stroke="currentColor" stroke-width="17" stroke-linecap="square">
              <path d="M90 20v140M20 90h140M40 40l100 100M40 140 140 40" />
            </g>
          </svg>
        </div>
        <span class="graphic-label">
          CONNECTING
          <br />
          THE SIGNALS.
        </span>
        <span class="graphic-coordinate">AI / 06H</span>
        <span class="graphic-dot dot-one"></span>
        <span class="graphic-dot dot-two"></span>
      </div>
    </section>
    <div class="briefing-strip">
      <span>
        <span class="live-dot"></span> 6시간마다 새 소식을 모읍니다
      </span>
      <span>
        마지막 콘텐츠 갱신{' '}
        <strong>
          {data.updated_at
            ? `${dateLabel(data.updated_at, true)} KST`
            : '첫 수집 대기'}
        </strong>
      </span>
      <a href="/sources/">
        {data.sources.filter((s) => s.enabled).length}개 출처 살펴보기 ↗
      </a>
    </div>
    {highlights.length > 0 && (
      <section class="highlights" id="briefing">
        <div class="section-heading">
          <div>
            <span class="eyebrow">IN FOCUS</span>
            <h2>먼저 읽어볼 소식</h2>
          </div>
          <span class="section-note">국내 보도 · 해외 공식 발표</span>
        </div>
        <div class="highlight-grid">
          {highlights.map((a, i) => (
            <a
              class:list={['highlight-card', { dark: i === 0 }]}
              href={`/news/${a.id}/`}
            >
              <div class="highlight-meta">
                <span>{a.category}</span>
                <span>0{i + 1} / BRIEF</span>
              </div>
              <h3>{a.title}</h3>
              <p>
                {a.summary ||
                  a.excerpt ||
                  '발표의 상세 내용은 원문에서 확인할 수 있습니다.'}
              </p>
              <div class="highlight-bottom">
                <span>
                  {sourceMap.get(a.sources[0].source_id)?.name} ·{' '}
                  {dateLabel(a.published_at)}
                </span>
                <span class="circle-arrow" aria-hidden="true">
                  ↗
                </span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
    <Feed articles={ranked.slice(0, 120)} />
    {articles.length > 120 && (
      <p class="archive-link">
        <a class="text-link" href="/archive/">
          이전 뉴스까지 모두 보기 ↗
        </a>
      </p>
    )}
    <aside class="editorial-banner">
      <span class="banner-mark" aria-hidden="true">
        ↗
      </span>
      <div>
        <span class="eyebrow">CONTEXT OVER NOISE</span>
        <h2>요약은 짧게, 출처는 분명하게.</h2>
        <p>
          공식 발표와 보도, 커뮤니티의 시선을 구분합니다.
          <br />
          AI가 요약한 내용은 원문과 함께 확인할 수 있습니다.
        </p>
      </div>
      <a href="/about/" class="button">
        편집 원칙 읽기 ↗
      </a>
    </aside>
  </div>
</Layout>
