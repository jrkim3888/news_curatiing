---
import Layout from '../layouts/Layout.astro';
import Feed from '../components/Feed.astro';
import Briefing from '../components/Briefing.astro';
import BriefingDays from '../components/BriefingDays.astro';
import { articles, data, dateLabel } from '../lib/data';
import { latestEdition, visibleDays, dayLabel } from '../lib/briefings';
---

<Layout>
  <div class="container">
    <header class="brief-home-heading">
      <div>
        <span class="eyebrow">YOUR DAILY AI PERSPECTIVE</span>
        <h1>
          오늘의 AI <em>브리핑.</em>
        </h1>
        <p>
          여러 소식을 하나의 맥락으로.
          <br class="mobile-only" /> 주요 이슈와 관련 원문을 함께 읽어보세요.
        </p>
      </div>
      <a class="text-link" href="/briefings/">
        지나간 브리핑 읽기 ↗
      </a>
    </header>
    <div class="briefing-strip">
      <span>6시간마다 수집 · 매일 오전 6:30 브리핑</span>
      <span>
        {latestEdition
          ? `${dayLabel(latestEdition.day)} 브리핑 · 06:30 발행 기준`
          : '첫 종합 브리핑 대기'}
      </span>
    </div>
    {latestEdition ? (
      <>
        <p
          class="brief-stale"
          data-briefing-asof={latestEdition.window_end}
          hidden
        >
          마지막 브리핑의 기준 시각에서 24시간 이상 지났습니다. 아래 내용은 당시
          저장된 기록입니다.
        </p>
        <Briefing edition={latestEdition} compact />
      </>
    ) : (
      <section class="brief-empty">
        <span class="eyebrow">THE BIG PICTURE</span>
        <h2>여러 소식을 함께 읽는 브리핑을 준비합니다.</h2>
        <p>
          종합 브리핑이 생성되면 주요 이슈와 근거 기사를 이곳에 보여드립니다.
          <br />
          지금은 아래에서 수집한 뉴스를 살펴볼 수 있습니다.
        </p>
        <a class="text-link" href="#news-feed">
          수집한 뉴스 읽기 ↓
        </a>
      </section>
    )}
    <section class="brief-home-history">
      <div class="section-heading">
        <div>
          <span class="eyebrow">PREVIOUSLY IN AI</span>
          <h2>날짜로 돌아보는 AI</h2>
        </div>
        <a href="/briefings/" class="text-link">
          히스토리 전체 보기 ↗
        </a>
      </div>
      {visibleDays.length ? (
        <BriefingDays days={visibleDays.slice(0, 3)} />
      ) : (
        <p class="brief-history-note">
          저장된 브리핑은 날짜별로 쌓입니다. 첫 기록부터 이곳에서 다시 읽을 수
          있습니다.
        </p>
      )}
    </section>
    <div id="news-feed">
      <Feed articles={articles.slice(0, 120)} />
    </div>
    <p class="brief-history-note">
      기사 데이터 갱신{' '}
      {data.updated_at
        ? `${dateLabel(data.updated_at, true)} KST`
        : '수집 대기'}{' '}
      · 기사 목록은 하루 한 번 발행하는 브리핑보다 먼저 갱신될 수 있습니다.
    </p>
    {articles.length > 120 && (
      <p class="archive-link">
        <a class="text-link" href="/archive/">
          이전 뉴스까지 모두 보기 ↗
        </a>
      </p>
    )}
    <aside class="editorial-banner">
      <span class="banner-mark" aria-hidden="true">
        ↗
      </span>
      <div>
        <span class="eyebrow">CONTEXT OVER NOISE</span>
        <h2>맥락은 함께, 출처는 분명하게.</h2>
        <p>
          공식 발표와 보도, AI의 해석을 구분합니다.
          <br />
          브리핑에서 관심 있는 이슈를 고르고 관련 원문을 확인하세요.
        </p>
      </div>
      <a href="/about/" class="button">
        편집 원칙 읽기 ↗
      </a>
    </aside>
  </div>
</Layout>
<script>
  const notice = document.querySelector<HTMLElement>('[data-briefing-asof]');
  if (notice)
    notice.hidden =
      Date.now() - Date.parse(notice.dataset.briefingAsof!) < 86400000;
</script>
