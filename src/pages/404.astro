---
import Layout from '../layouts/Layout.astro';
---

<Layout title="페이지를 찾을 수 없습니다" noindex>
  <div class="container page-content empty-page">
    <span class="eyebrow">404 / SIGNAL NOT FOUND</span>
    <h1>이 소식은 여기 없네요.</h1>
    <p>주소가 변경되었거나 삭제된 페이지입니다.</p>
    <a class="button" href="/">
      최신 브리핑으로 돌아가기 ↗
    </a>
  </div>
</Layout>
