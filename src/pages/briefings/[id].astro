---
import Layout from '../../layouts/Layout.astro';
import Briefing from '../../components/Briefing.astro';
import { editions, dayLabel, editionUrl } from '../../lib/briefings';
export function getStaticPaths() {
  return editions.map((edition) => ({
    params: { id: edition.id },
    props: { edition },
  }));
}
const { edition: e } = Astro.props;
const index = editions.findIndex((item) => item.id === e.id);
const previous = editions[index + 1];
---

<Layout
  title={`${dayLabel(e.day)} 일일 브리핑`}
  description={e.headline}
  noindex={e.status === 'withdrawn'}
>
  <div class="container page-content brief-reading-page">
    <a href="/briefings/" class="text-link">
      ← 브리핑 히스토리
    </a>
    <header class="brief-reading-heading">
      <span class="eyebrow">AN EDITION TO KEEP</span>
      <h1>
        {dayLabel(e.day)}
        <br />
        일일 브리핑
      </h1>
      <p>
        매일 오전 6시 30분 발행 기준 · 전날 오전 6시부터 당일 오전 6시까지의
        24시간을 정리합니다.
      </p>
    </header>
    <Briefing edition={e} />
    <nav class="brief-bottom-nav" aria-label="날짜 이동">
      {previous ? (
        <a href={editionUrl(previous)}>← {dayLabel(previous.day)}</a>
      ) : (
        <a href="/briefings/">← 히스토리</a>
      )}
      {editions[index - 1] ? (
        <a href={editionUrl(editions[index - 1])}>
          {dayLabel(editions[index - 1].day)} →
        </a>
      ) : (
        <a href="/">최신 브리핑 →</a>
      )}
    </nav>
  </div>
</Layout>
