---
import Layout from '../../layouts/Layout.astro';
import BriefingDays from '../../components/BriefingDays.astro';
import { visibleDays } from '../../lib/briefings';
---

<Layout
  title="브리핑 히스토리"
  description="매일 오전 6시 30분 발행하는 AI 일일 브리핑. 24시간의 주요 이슈와 관련 원문을 날짜별로 다시 읽어보세요."
>
  <div class="container page-content brief-history-page">
    <div class="brief-page-heading">
      <div>
        <span class="eyebrow">THE BRIEFING JOURNAL</span>
        <h1>
          AI의 흐름을,
          <br />
          날짜별로.
        </h1>
        <p>
          그날 어떤 이슈를 살펴봤는지 다시 읽어보세요.
          <br />
          매일 오전 6시 30분, 하루의 AI 소식을 한 편으로 남깁니다.
        </p>
      </div>
      <div class="brief-history-total">
        <strong>{visibleDays.length}</strong>
        <span>일의 기록</span>
      </div>
    </div>
    {visibleDays.length ? (
      <>
        <div class="brief-history-tools">
          <label>
            기간{' '}
            <input
              id="history-month"
              type="month"
              aria-label="브리핑 월 선택"
            />
          </label>
          <label class="brief-history-query">
            이슈 찾기{' '}
            <input
              id="history-query"
              type="search"
              placeholder="제목이나 이슈 키워드"
            />
          </label>
          <button type="button" class="text-link" id="history-reset">
            전체 보기
          </button>
        </div>
        <p class="brief-history-note">
          전날 오전 6시부터 당일 오전 6시까지의 소식을 날짜당 한 편으로
          보관합니다. 모든 시각은 한국 시간(KST) 기준입니다.
        </p>
        <p id="history-count" class="sr-only" aria-live="polite">
          {visibleDays.length}일의 브리핑
        </p>
        <BriefingDays days={visibleDays} filterable />
        <div id="history-empty" class="brief-empty" hidden>
          <h2>조건에 맞는 기록이 없습니다.</h2>
          <p>
            다른 기간이나 키워드로 찾아보세요. 브리핑을 저장하지 않은 날짜는
            표시하지 않습니다.
          </p>
        </div>
        <noscript>
          <p>
            기간·키워드 필터에는 JavaScript가 필요합니다. 아래 날짜별 브리핑은
            그대로 읽을 수 있습니다.
          </p>
        </noscript>
      </>
    ) : (
      <div class="brief-empty">
        <span class="eyebrow">THE FIRST CHAPTER</span>
        <h2>첫 브리핑을 기다리고 있습니다.</h2>
        <p>
          AI 종합 브리핑이 생성되면 날짜별로 이곳에 쌓입니다.
          <br />
          수집한 개별 기사는 지금도 볼 수 있습니다.
        </p>
        <a href="/archive/" class="button">
          수집한 뉴스 보기 ↗
        </a>
      </div>
    )}
    <div class="brief-bottom-nav">
      <a href="/" class="text-link">
        ← 최신 브리핑
      </a>
      <a href="/archive/" class="text-link">
        개별 기사 아카이브 ↗
      </a>
    </div>
  </div>
</Layout>
<script>
  const month = document.querySelector<HTMLInputElement>('#history-month');
  const query = document.querySelector<HTMLInputElement>('#history-query');
  if (month && query) {
    const params = new URLSearchParams(location.search);
    month.value = /^\d{4}-\d{2}$/.test(params.get('month') || '')
      ? params.get('month')!
      : '';
    query.value = params.get('q') || '';
    const filter = () => {
      let count = 0;
      document
        .querySelectorAll<HTMLElement>('[data-history-day]')
        .forEach((card) => {
          card.hidden =
            !card.dataset.historyDay!.startsWith(month.value) ||
            !card.dataset.historyText!.includes(
              query.value.trim().toLocaleLowerCase(),
            );
          if (!card.hidden) count++;
        });
      document.querySelector<HTMLElement>('#history-empty')!.hidden =
        count !== 0;
      document.querySelector('#history-count')!.textContent =
        `${count}일의 브리핑`;
      const next = new URLSearchParams();
      if (month.value) next.set('month', month.value);
      if (query.value) next.set('q', query.value);
      window.history.replaceState(
        null,
        '',
        `${location.pathname}${next.size ? `?${next}` : ''}`,
      );
    };
    month.addEventListener('input', filter);
    query.addEventListener('input', filter);
    document.querySelector('#history-reset')!.addEventListener('click', () => {
      month.value = '';
      query.value = '';
      filter();
    });
    filter();
  }
</script>
