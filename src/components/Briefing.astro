---
import {
  editionUrl,
  dayLabel,
  timeLabel,
  dateTimeLabel,
  rangeLabel,
  splitFact,
  briefingRecord,
  type Edition,
} from '../lib/briefings';
import { roleNames } from '../lib/data';
import { kstDay } from '../lib/dates';
interface Props {
  edition: Edition;
  compact?: boolean;
}
const { edition: e, compact = false } = Astro.props;
const snapshots = new Map(e.articles.map((a) => [a.id, a]));
---

<article
  class="brief-edition"
  aria-label={e.headline}
  data-pagefind-meta={
    !compact ? 'title[aria-label], record[data-record]' : undefined
  }
  data-record={
    !compact && e.status === 'published'
      ? JSON.stringify(briefingRecord(e))
      : undefined
  }
  data-pagefind-filter={
    !compact && e.status === 'published' ? 'kind:briefing' : undefined
  }
  data-pagefind-sort={!compact ? 'published[data-published]' : undefined}
  data-published={e.window_end}
  data-pagefind-body={!compact || undefined}
  data-pagefind-ignore={compact || e.status === 'withdrawn' || undefined}
>
  {!compact && e.status === 'published' && (
    <span data-pagefind-filter={`month:${e.day.slice(0, 7)}`}></span>
  )}
  {e.status === 'withdrawn' ? (
    <div class="brief-empty">
      <h2>비공개 처리된 브리핑입니다.</h2>
      <p>편집 정책에 따라 이날 브리핑의 내용을 제공하지 않습니다.</p>
      <a href="/briefings/" class="text-link">
        다른 브리핑 보기 ↗
      </a>
    </div>
  ) : (
    <>
      <div class="brief-overview">
        <div class="brief-overview-heading">
          <span>하루를 읽는 요약</span>
          <div class="brief-publication">
            <span>AI 종합 · {e.issues.length}개 이슈</span>
            <time
              datetime={e.generated_at}
              title="브리핑을 생성해 저장한 시각 기준"
            >
              발행 · {kstDay(new Date(e.generated_at)).replaceAll('-', '.')}{' '}
              {timeLabel(e.generated_at)} KST
            </time>
          </div>
        </div>
        <h2>{e.headline}</h2>
        {e.takeaway && (
          <div class="brief-takeaway">
            <span>{compact ? '오늘의 한 줄' : '이날의 한 줄'}</span>
            <p>{e.takeaway}</p>
          </div>
        )}
        <div class="brief-overview-copy">
          {e.overview.map((entry) => (
            <p>
              {entry.text}{' '}
              <span class="brief-overview-links">
                {entry.issue_ids.map((id) => (
                  <a
                    href={`#${id}`}
                    aria-label={`${e.issues.find((i) => i.id === id)!.title} 이슈로 이동`}
                    title={e.issues.find((i) => i.id === id)!.title}
                  >
                    관련 이슈 {id.split('-')[1]}{' '}
                    <span aria-hidden="true">↓</span>
                  </a>
                ))}
              </span>
            </p>
          ))}
        </div>
        <p class="brief-window">집계 범위 · {rangeLabel(e)}</p>
        {e.overview_revision && (
          <p class="brief-revision">
            <time datetime={e.overview_revision.revised_at}>
              {dateTimeLabel(e.overview_revision.revised_at)} KST
            </time>{' '}
            · {e.overview_revision.note}
          </p>
        )}
      </div>
      <div class="brief-issues">
        {e.issues.map((issue, index) => (
          <section class="brief-issue" id={issue.id}>
            <div class="brief-issue-number">
              {String(index + 1).padStart(2, '0')}
            </div>
            <div class="brief-issue-content">
              <div class="brief-issue-meta">
                <span>{issue.category}</span>
                <time
                  datetime={e.day}
                  title="이 이슈가 실린 브리핑의 발행 기준일"
                >
                  {e.day.replaceAll('-', '.')} 브리핑
                </time>
                <span>
                  관련 기사 {issue.article_ids.length}건
                  {issue.article_ids.length === 1 ? ' · 단일 기사 근거' : ''}
                </span>
              </div>
              <h3>{issue.title}</h3>
              <div class="brief-facts">
                {issue.facts.map((fact) => (
                  <p>
                    {splitFact(fact).map((part) => {
                      if (!part.article_id) return part.text;
                      const article = snapshots.get(part.article_id)!;
                      const source = article.sources[0];
                      return (
                        <a
                          class="brief-keyword-link"
                          href={source.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          title={`${source.name}: ${article.title}`}
                          aria-label={`${part.text} — ${source.name} 원문 (새 탭)`}
                        >
                          {part.text}
                        </a>
                      );
                    })}
                  </p>
                ))}
              </div>
              <div class="brief-meaning">
                <strong>
                  살펴볼 이유 <small>AI 해석</small>
                </strong>
                <p>{issue.why_it_matters}</p>
              </div>
              <div class="brief-source-list">
                <h4>관련 원문에서 더 읽기</h4>
                {issue.article_ids.map((id) => {
                  const article = snapshots.get(id)!;
                  const primary = article.sources[0];
                  return (
                    <div class="brief-source" id={`source-${issue.id}-${id}`}>
                      <span class="brief-source-caption">
                        {primary.name} ·{' '}
                        {roleNames[primary.role] || primary.role}
                        <time datetime={article.published_at}>
                          원문 발행 ·{' '}
                          {kstDay(new Date(article.published_at)).replaceAll(
                            '-',
                            '.',
                          )}{' '}
                          KST
                        </time>
                      </span>
                      <a
                        href={primary.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {article.title} <span aria-hidden="true">↗</span>
                      </a>
                      {primary.discussion_url && (
                        <a
                          class="discussion-link"
                          href={primary.discussion_url}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          커뮤니티 토론 ↗
                        </a>
                      )}
                      {article.sources.length > 1 && (
                        <details>
                          <summary>
                            함께 수집한 출처 {article.sources.length - 1}개
                          </summary>
                          {article.sources.slice(1).map((ref) => (
                            <a
                              href={ref.url}
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              {ref.name} · {ref.title} ↗
                            </a>
                          ))}
                        </details>
                      )}
                      {article.correction && (
                        <p class="brief-correction">
                          <strong>정정 메모</strong> {article.correction}
                        </p>
                      )}
                    </div>
                  );
                })}
              </div>
            </div>
          </section>
        ))}
      </div>
      <div class="brief-disclosure">
        <p>
          수집 자료를 바탕으로 AI가 종합했습니다. 인용 구절의 원문 포함 여부를
          검사하지만, 사실 전체의 정확성을 보장하지는 않습니다. 중요한 내용은
          관련 원문에서 확인하세요.
        </p>
        {compact ? (
          <a class="text-link" href={editionUrl(e)}>
            이날의 브리핑 페이지 ↗
          </a>
        ) : (
          <details>
            <summary>생성 정보</summary>
            <p>
              발행 예정 {dayLabel(e.day)} {timeLabel(e.scheduled_at)} KST
              <br />
              실제 생성{' '}
              {dayLabel(
                new Date(Date.parse(e.generated_at) + 9 * 3600000)
                  .toISOString()
                  .slice(0, 10),
              )}{' '}
              {timeLabel(e.generated_at)} KST
              <br />
              {e.model} · {e.prompt_version} · 분석 자료 {e.reviewed_articles}건
            </p>
          </details>
        )}
      </div>
    </>
  )}
</article>
