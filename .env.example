# Only the Python collector uses these. Never add an API key to PUBLIC_* variables.
OPENROUTER_API_KEY=
# Copy an available model ID from https://openrouter.ai/models
OPENROUTER_MODEL=
# 0 disables the daily briefing. A daily briefing uses at most one request.
# Also caps explicit --summarize-articles runs. Set a credit limit at OpenRouter.
MAX_SUMMARIES_PER_RUN=1
# Total output budget for the briefing and its selected article summaries.
# Includes reasoning tokens where the provider counts them toward the limit.
BRIEFING_MAX_TOKENS=18432
# Set this in Cloudflare Pages too, after the project URL is assigned.
SITE_URL=https://your-project.pages.dev
