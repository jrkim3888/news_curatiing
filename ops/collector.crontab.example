# Install with crontab -e as the unprivileged news user. VM timezone: UTC.
# Collection: KST 00:00, 06:00, 12:00, 18:00. Daily briefing: KST 06:30.
# Shared flock serializes both jobs. A delayed daily job recovers a missing morning collection.
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
0 3,9,15,21 * * * cd /opt/ai-brief && NEWS_MODE=collect /usr/bin/timeout --signal=TERM --kill-after=30s 50m /bin/bash ops/run-collector.sh >> /opt/ai-brief/.runtime/cron.log 2>&1
30 21 * * * cd /opt/ai-brief && NEWS_MODE=brief /usr/bin/timeout --signal=TERM --kill-after=30s 50m /bin/bash ops/run-collector.sh >> /opt/ai-brief/.runtime/cron.log 2>&1
