{
  "name": "ai-brief",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "check": "astro check",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview --host 0.0.0.0",
    "test": ".venv/bin/python -m unittest discover -s tests -v",
    "test:browser": "playwright test",
    "format": "prettier --write src astro.config.mjs playwright.config.ts tests/browser"
  },
  "dependencies": {
    "astro": "7.4.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "pagefind": "1.5.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^5.9.3"
  }
}
